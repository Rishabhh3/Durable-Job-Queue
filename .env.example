# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored. This file is the committed reference, so keep the
# values here fake or local-only.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# One of: dev, test, prod.
# Outside dev, DJQ_DATABASE_URL below is required and startup fails without it.
DJQ_ENV=dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/database
# From your machine, host is 127.0.0.1.
# From inside another container on the compose network, host is "postgres".
DJQ_DATABASE_URL=postgresql+asyncpg://djq:djq@127.0.0.1:5432/djq_dev

# Connection pool. pool_size is the hard ceiling; overflow 0 means no
# temporary extras, so callers wait instead of opening more connections.
# pool_timeout is how long a caller waits before giving up.
DJQ_POOL_SIZE=5
DJQ_POOL_MAX_OVERFLOW=0
DJQ_POOL_TIMEOUT_SECONDS=10.0

# ---------------------------------------------------------------------------
# Queue behaviour
# ---------------------------------------------------------------------------
# A worker holds a job for lease_seconds. If it dies, the job becomes
# available again after the lease expires.
DJQ_LEASE_SECONDS=30.0

# How often a healthy worker extends its lease. Must be under half the lease,
# so one missed beat doesn't cost a working worker its job.
DJQ_HEARTBEAT_SECONDS=10.0

# Total tries per job before it goes to the dead letter table.
DJQ_MAX_ATTEMPTS=5

# Retry delay grows as base^attempt, capped at max.
# With base 2.0: roughly 2s, 4s, 8s, 16s between retries.
DJQ_BACKOFF_BASE_SECONDS=2.0
DJQ_BACKOFF_MAX_SECONDS=600.0

# ---------------------------------------------------------------------------
# Worker loop
# ---------------------------------------------------------------------------
# How long a worker waits before checking for new jobs again.
DJQ_POLL_INTERVAL_SECONDS=1.0

# Random wobble added to the poll interval, as a fraction (0.3 = up to 30%).
# Stops many workers from waking at the same instant and stampeding the table.
DJQ_POLL_JITTER=0.3

# Jobs claimed per poll.
DJQ_BATCH_SIZE=1